<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      APK interna targetSdk 35: mantenemos el layout clásico para que las
      pantallas programáticas no queden bajo las barras del sistema en Android 15.
      Cuando se migre a targetSdk 36 habrá que retirar este opt-out y aplicar
      WindowInsets de forma nativa a todas las pantallas.
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#111111</item>
        <item name="android:navigationBarColor">#111111</item>
        <item name="android:statusBarColor">#111111</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
