{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mesonofaro-observability",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mesonofaro-analytics",
      "database_id": "SUSTITUIR_POR_ID_REAL"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
