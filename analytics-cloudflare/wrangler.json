{
  "name": "meson-o-faro-seguridad-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
