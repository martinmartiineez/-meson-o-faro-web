{
  "name": "meson-o-faro-analytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/worker.js && node --check src/dashboard.js && node --check src/consent.js",
    "test": "npm run check && node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run test && npm run build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply mesonofaro-analytics --local",
    "migrate:remote": "wrangler d1 migrations apply mesonofaro-analytics --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
